# Copy to .env.local for `npm run dev`. Read on the server only (no NEXT_PUBLIC_ prefix, so none of it reaches the browser).
# Where The Crew's API runs. Locally that is the portfolio dev server, which skips auth on localhost.
CREW_API_BASE=http://localhost:5288
# The portfolio's ADMIN_TOKEN, sent as a Bearer token. Not needed against localhost with ADMIN_DEV_BYPASS.
CREW_ADMIN_TOKEN=
# Leave unset for demo data (seeded sample members). Set to 1 only on a private deploy to see real members.
CREW_REAL=
